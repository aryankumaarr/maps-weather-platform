# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# ---- PostgreSQL ----
POSTGRES_USER=maps_weather
POSTGRES_PASSWORD=changeme
POSTGRES_DB=maps_weather
POSTGRES_PORT=5432
DATABASE_URL=postgresql://maps_weather:changeme@postgres:5432/maps_weather

# ---- Redis ----
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ---- Backend (FastAPI) ----
# Server-side only — used for Directions/Routes/Geocoding calls FastAPI makes on
# the backend's behalf. Never expose this one to the frontend.
BACKEND_PORT=8000
SECRET_KEY=changeme
WEATHER_API_KEY=
GOOGLE_MAPS_API_KEY=

# ---- Frontend (Next.js) ----
# NEXT_PUBLIC_ vars are bundled into client-side JS and visible to anyone —
# only put a key here if it's restricted (HTTP referrer lock) for that reason.
# This one is for rendering the map itself (Google Maps JavaScript API), which
# requires a client-visible key by design — restrict it to our domain in the
# Google Cloud Console. It is a different key from GOOGLE_MAPS_API_KEY above.
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---- Monitoring (optional, `docker compose --profile monitoring up`) ----
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme
PROMETHEUS_PORT=9090

# ---- pgAdmin (optional, `docker compose --profile tools up`) ----
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=changeme
