# Copy this file to .env.local and fill in real values.
# Next.js reads .env.local automatically when running `npm run dev` — it does
# NOT read the root .env (that one's only for Docker Compose / the backend).
# .env.local is gitignored — never commit real secrets.

# Where the backend is reachable. Matches BACKEND_PORT in the root .env.
NEXT_PUBLIC_API_URL=http://localhost:8000

# NEXT_PUBLIC_ vars are bundled into client-side JS and visible to anyone —
# only put a key here if it's restricted (HTTP referrer lock) for that reason.
# This one is for rendering the map itself (Google Maps JavaScript API), which
# requires a client-visible key by design — restrict it to our domain in the
# Google Cloud Console. It is a different key from the server-side
# GOOGLE_MAPS_API_KEY the backend uses for Directions/Routes/Geocoding.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
